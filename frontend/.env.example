# Real backend URL (used when VITE_USE_MOCK_API=false)
VITE_API_BASE=http://localhost:8000

# true  → all API calls served from src/services/api.mock.ts (no network,
#         canned data, simulated SSE latency). Use for demos and UI dev.
# false → hit the real FastAPI backend at VITE_API_BASE.
VITE_USE_MOCK_API=false
